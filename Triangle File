<title>Triangle Lab</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wght@600;700&family=IBM+Plex+Mono:wght@400;600&family=IBM+Plex+Sans:wght@400;600&display=swap">
<style>
:root{
  --ground:#e9edf3; --surface:#ffffff; --surface2:#f4f7fb;
  --ink:#14202e; --ink2:#4a5a70; --ink3:#7688a0;
  --line:#d2dae6; --line2:#bcc8d9;
  --navy:#0a2a5e; --blue:#12468f; --blue-soft:#eaf1fb;
  --gold:#ffc72c; --gold-ink:#7d6100;
  --grid:#dde4ee; --grid2:#c3cfe0;
  --canvas-bg:#ffffff; --shape:#0a2a5e; --shape-fill:rgba(10,42,94,.07);
  --p1:#d1495b; --p2:#118ab2; --p3:#06a77d;
  --code-bg:#0d1b2a; --code-ink:#e6edf5;
  --focus:#12468f;
  --btn-bg:#0a2a5e; --btn-ink:#ffffff;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    color-scheme:dark;
    --ground:#0a111c; --surface:#131d2c; --surface2:#182434;
    --ink:#e8eef7; --ink2:#a8b8cd; --ink3:#7b8ca4;
    --line:#26354a; --line2:#35486280;
    --navy:#9dc0ee; --blue:#7aa9e6; --blue-soft:#17263c;
    --gold:#ffc72c; --gold-ink:#ffd873;
    --grid:#1e2b3d; --grid2:#2c3e57;
    --canvas-bg:#0f1826; --shape:#9dc0ee; --shape-fill:rgba(157,192,238,.10);
    --p1:#f07a88; --p2:#4cc4e8; --p3:#4fd6a8;
    --code-bg:#080f18; --code-ink:#e6edf5;
    --focus:#9dc0ee;
    --btn-bg:#2f6bc0; --btn-ink:#ffffff;
  }
}
:root[data-theme="dark"]{
  color-scheme:dark;
  --ground:#0a111c; --surface:#131d2c; --surface2:#182434;
  --ink:#e8eef7; --ink2:#a8b8cd; --ink3:#7b8ca4;
  --line:#26354a; --line2:#354862;
  --navy:#9dc0ee; --blue:#7aa9e6; --blue-soft:#17263c;
  --gold:#ffc72c; --gold-ink:#ffd873;
  --grid:#1e2b3d; --grid2:#2c3e57;
  --canvas-bg:#0f1826; --shape:#9dc0ee; --shape-fill:rgba(157,192,238,.10);
  --p1:#f07a88; --p2:#4cc4e8; --p3:#4fd6a8;
  --code-bg:#080f18; --code-ink:#e6edf5;
  --focus:#9dc0ee;
  --btn-bg:#2f6bc0; --btn-ink:#ffffff;
}
*{box-sizing:border-box}
html,body{margin:0}
body{
  background:var(--ground); color:var(--ink);
  font-family:"IBM Plex Sans",system-ui,-apple-system,"Segoe UI",sans-serif;
  font-size:15px; line-height:1.55;
}
.wrap{max-width:1180px; margin:0 auto; padding-inline:16px; padding-block:20px 48px}
h1,h2,h3{font-family:Archivo,"IBM Plex Sans",system-ui,sans-serif; text-wrap:balance; margin:0}
.mono{font-family:"IBM Plex Mono",ui-monospace,Menlo,Consolas,monospace; font-variant-numeric:tabular-nums}

/* ---------- header ---------- */
header{display:flex; flex-wrap:wrap; gap:14px 20px; align-items:flex-end; justify-content:space-between;
  padding-bottom:16px; border-bottom:3px solid var(--gold); margin-bottom:22px}
.brand{display:flex; gap:12px; align-items:center}
.roundel{width:44px; height:44px; border-radius:50%; background:var(--gold); color:#0a2a5e;
  display:grid; place-items:center; font-family:Archivo,sans-serif; font-weight:700; font-size:17px; flex:none}
.eyebrow{font-size:11px; font-weight:600; letter-spacing:.14em; color:var(--blue); text-transform:uppercase}
h1{font-size:27px; font-weight:700; letter-spacing:-.01em; line-height:1.1}
.sub{color:var(--ink2); font-size:14px; max-width:52ch; margin-top:3px}

/* ---------- layout ---------- */
.stage{display:grid; grid-template-columns:minmax(0,1fr) 370px; gap:20px; align-items:start}
@media (max-width:900px){ .stage{grid-template-columns:minmax(0,1fr)} }

.panel{background:var(--surface); border:1px solid var(--line); border-radius:12px}
.panel-hd{display:flex; align-items:center; justify-content:space-between; gap:10px;
  padding:11px 14px; border-bottom:1px solid var(--line)}
.panel-hd h2{font-size:12px; font-weight:700; letter-spacing:.12em; text-transform:uppercase; color:var(--ink2)}
.panel-bd{padding:14px}

/* ---------- canvas ---------- */
.canvas-card{padding:14px}
.canvas-shell{position:relative; width:100%; max-width:560px; margin:0 auto; aspect-ratio:1/1}
canvas{display:block; width:100%; height:100%; max-width:100%; border:1px solid var(--line2);
  border-radius:8px; background:var(--canvas-bg); touch-action:none; cursor:crosshair}
canvas:focus-visible{outline:3px solid var(--focus); outline-offset:2px}
.hint{margin:10px auto 0; max-width:560px; font-size:12.5px; color:var(--ink3); text-align:center}

.toolbar{display:flex; flex-wrap:wrap; gap:8px; align-items:center; justify-content:center;
  max-width:560px; margin:0 auto 12px}
.chip{display:inline-flex; align-items:center; gap:6px; padding:5px 11px; border-radius:999px;
  border:1px solid var(--line2); background:var(--surface2); color:var(--ink2);
  font-size:12.5px; font-weight:600; cursor:pointer; user-select:none}
.chip:hover{border-color:var(--blue); color:var(--blue)}
.chip[aria-pressed="true"]{background:var(--btn-bg); border-color:var(--btn-bg); color:var(--btn-ink)}
.chip:focus-visible{outline:2px solid var(--focus); outline-offset:2px}

/* ---------- tabs ---------- */
.tabs{display:flex; gap:4px; padding:4px; background:var(--surface2);
  border:1px solid var(--line); border-radius:10px; margin-bottom:14px}
.tab{flex:1; padding:8px 6px; border:0; border-radius:7px; background:transparent; cursor:pointer;
  font-family:Archivo,sans-serif; font-weight:600; font-size:13px; color:var(--ink2)}
.tab[aria-selected="true"]{background:var(--btn-bg); color:var(--btn-ink)}
.tab:focus-visible{outline:2px solid var(--focus); outline-offset:1px}

/* ---------- readouts ---------- */
.kv{display:grid; grid-template-columns:1fr auto; gap:4px 12px; align-items:baseline}
.kv dt{font-size:12.5px; color:var(--ink2)}
.kv dd{margin:0; font-family:"IBM Plex Mono",monospace; font-variant-numeric:tabular-nums;
  font-size:13px; font-weight:600; color:var(--ink)}
.rule{height:1px; background:var(--line); margin:12px 0}
.badge{display:inline-block; padding:3px 9px; border-radius:6px; font-size:11.5px; font-weight:600;
  letter-spacing:.06em; text-transform:uppercase; background:var(--gold); color:#5c4700}
.badge.quiet{background:var(--blue-soft); color:var(--blue)}
.ptrow{display:flex; align-items:center; gap:9px; padding:6px 0}
.dot{width:13px; height:13px; border-radius:50%; flex:none; border:2px solid var(--surface)}
.ptrow .lbl{font-family:Archivo,sans-serif; font-weight:700; font-size:13px; width:22px}
.ptrow .val{font-family:"IBM Plex Mono",monospace; font-size:13.5px; font-variant-numeric:tabular-nums;
  color:var(--ink); font-weight:600}
.ptrow button{margin-left:auto; border:1px solid var(--line2); background:var(--surface2); color:var(--ink2);
  border-radius:6px; width:26px; height:26px; cursor:pointer; font-size:13px; line-height:1}
.ptrow button:hover{border-color:var(--blue); color:var(--blue)}

.note{background:var(--blue-soft); border-left:4px solid var(--blue); border-radius:0 8px 8px 0;
  padding:10px 13px; font-size:13px; color:var(--ink); margin-top:12px}
.note b{color:var(--blue)}
.note .mono{font-size:12.5px}

/* ---------- recipe cards ---------- */
.recipes{display:grid; gap:8px}
.recipe{display:grid; grid-template-columns:52px minmax(0,1fr); gap:11px; align-items:center; text-align:left;
  width:100%; padding:9px 11px; border:1px solid var(--line); border-radius:9px;
  background:var(--surface); cursor:pointer; color:inherit; font:inherit}
.recipe:hover{border-color:var(--blue); background:var(--surface2)}
.recipe:focus-visible{outline:2px solid var(--focus); outline-offset:1px}
.recipe[aria-pressed="true"]{border-color:var(--blue); background:var(--blue-soft)}
.recipe svg{display:block; width:52px; height:44px}
.recipe .rname{font-family:Archivo,sans-serif; font-weight:600; font-size:13.5px; line-height:1.25}
.recipe .rmath{font-family:"IBM Plex Mono",monospace; font-size:11.5px; color:var(--ink2); margin-top:2px;
  overflow-wrap:anywhere}

/* ---------- compose ---------- */
.stacklist{display:flex; flex-direction:column; gap:6px; max-height:230px; overflow-y:auto; margin-bottom:12px}
.sitem{display:flex; align-items:center; gap:8px; padding:6px 9px; border:1px solid var(--line);
  border-radius:8px; background:var(--surface2); font-size:12.5px}
.sitem .sw{width:14px; height:14px; border-radius:4px; border:1px solid var(--line2); flex:none}
.sitem .snm{flex:1; min-width:0; overflow:hidden; text-overflow:ellipsis; white-space:nowrap}
.sitem .sco{font-family:"IBM Plex Mono",monospace; font-size:11px; color:var(--ink3); flex:none}
.sitem button{border:1px solid var(--line2); background:var(--surface); color:var(--ink2); border-radius:5px;
  width:23px; height:23px; cursor:pointer; font-size:12px; line-height:1; flex:none}
.sitem button:hover{border-color:var(--blue); color:var(--blue)}
.empty{padding:22px 12px; text-align:center; color:var(--ink3); font-size:13px;
  border:1px dashed var(--line2); border-radius:9px; margin-bottom:12px}

.btnrow{display:flex; flex-wrap:wrap; gap:7px}
.btn{padding:8px 13px; border-radius:8px; border:1px solid var(--btn-bg); background:var(--btn-bg); color:var(--btn-ink);
  font-family:Archivo,sans-serif; font-weight:600; font-size:13px; cursor:pointer}
.btn:hover{filter:brightness(1.12)}
.btn:focus-visible{outline:2px solid var(--focus); outline-offset:2px}
.btn.ghost{background:transparent; color:var(--blue); border-color:var(--line2)}
.btn.ghost:hover{border-color:var(--blue); background:var(--surface2)}
.btn.gold{background:var(--gold); border-color:var(--gold); color:#4d3c00}

h3.sec{font-size:11px; font-weight:700; letter-spacing:.13em; text-transform:uppercase; color:var(--ink3);
  margin:16px 0 8px}
h3.sec:first-child{margin-top:0}

/* ---------- code ---------- */
.codewrap{margin-top:20px}
pre{margin:0; background:var(--code-bg); color:var(--code-ink); border-radius:0 0 11px 11px;
  padding:15px 17px; overflow-x:auto; font-family:"IBM Plex Mono",monospace; font-size:13px; line-height:1.6}
.codewrap .panel-hd{border-bottom:0; background:var(--code-bg); border-radius:11px 11px 0 0;
  border:0; padding:11px 17px 4px}
.codewrap .panel-hd h2{color:#8ba6c4}
.codewrap{border:1px solid var(--line); border-radius:12px; overflow:hidden}
.k-fn{color:#7ec8e0} .k-num{color:#ffd66b} .k-com{color:#7a8fa6}
.copybtn{border:1px solid #2b3f57; background:#18293d; color:#c7d7ea; border-radius:6px;
  padding:4px 10px; font-size:12px; font-weight:600; cursor:pointer; font-family:"IBM Plex Sans",sans-serif}
.copybtn:hover{border-color:#4a688c; color:#fff}

/* ---------- legend strip ---------- */
.legend{display:flex; flex-wrap:wrap; gap:8px 18px; justify-content:center; margin:0 auto 12px; max-width:560px;
  font-size:12.5px; color:var(--ink2)}
.legend span{display:inline-flex; align-items:center; gap:6px}
.sr{position:absolute; width:1px; height:1px; overflow:hidden; clip:rect(0 0 0 0); white-space:nowrap}
@media (prefers-reduced-motion:reduce){*{animation:none!important; transition:none!important}}
