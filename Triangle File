<script>
(function(){
"use strict";
var C=400, R=function(n){return Math.round(n)};
var clamp=function(v){return Math.max(0,Math.min(C,v))};

var P=[{x:100,y:300},{x:300,y:300},{x:200,y:150}];
var PC=['--p1','--p2','--p3'], PN=['P1','P2','P3'];
var snap=true, grid=true, labels=true, guides=false, colorMode=false;
var sel=2, mode='build', stack=[], activeRecipe=null;

var PALETTE=['#d1495b','#118ab2','#06a77d','#ffb703','#8338ec','#fb5607','#3a86ff','#2a9d8f'];

/* ---------------- storage ---------------- */
function save(){ try{ localStorage.setItem('trilab', JSON.stringify({P:P,stack:stack,colorMode:colorMode})); }catch(e){} }
function load(){
  try{
    var r=localStorage.getItem('trilab'); if(!r) return;
    var d=JSON.parse(r);
    if(d && d.P && d.P.length===3) P=d.P.map(function(p){return {x:clamp(p.x|0), y:clamp(p.y|0)};});
    if(d && Array.isArray(d.stack)) stack=d.stack;
    if(d && typeof d.colorMode==='boolean') colorMode=d.colorMode;
  }catch(e){}
}

/* ---------------- geometry (all display arithmetic) ---------------- */
function dist(a,b){ return Math.sqrt((a.x-b.x)*(a.x-b.x)+(a.y-b.y)*(a.y-b.y)); }
function mid(a,b){ return {x:(a.x+b.x)/2, y:(a.y+b.y)/2}; }
function centroid(p){ return {x:(p[0].x+p[1].x+p[2].x)/3, y:(p[0].y+p[1].y+p[2].y)/3}; }
function area(p){ return Math.abs(p[0].x*(p[1].y-p[2].y)+p[1].x*(p[2].y-p[0].y)+p[2].x*(p[0].y-p[1].y))/2; }
function near(a,b,tol){ return Math.abs(a-b) <= (tol===undefined?2:tol); }

function classify(p){
  var s=[dist(p[0],p[1]),dist(p[1],p[2]),dist(p[2],p[0])];
  if(area(p) < 1) return 'Flat line';
  var sq=s.map(function(v){return v*v;}).sort(function(a,b){return a-b;});
  var right = Math.abs(sq[0]+sq[1]-sq[2]) < sq[2]*0.03;
  var mx=Math.max.apply(null,s), mn=Math.min.apply(null,s);
  if((mx-mn)/mx < 0.03) return 'Equilateral';
  var iso = near(s[0],s[1],mx*0.03)||near(s[1],s[2],mx*0.03)||near(s[0],s[2],mx*0.03);
  if(right && iso) return 'Right isosceles';
  if(right) return 'Right';
  if(iso) return 'Isosceles';
  return 'Scalene';
}

/* Find a horizontal or vertical base so we can talk about "base" and "apex". */
function anatomy(p){
  var pairs=[[0,1,2],[1,2,0],[0,2,1]], i, a, b, c;
  for(i=0;i<3;i++){
    a=p[pairs[i][0]]; b=p[pairs[i][1]]; c=p[pairs[i][2]];
    if(a.y===b.y) return {kind:'h', base:[a,b], apex:c, width:Math.abs(b.x-a.x),
                          height:Math.abs(c.y-a.y), baseMidX:(a.x+b.x)/2, centered:(a.x+b.x)/2===c.x};
  }
  for(i=0;i<3;i++){
    a=p[pairs[i][0]]; b=p[pairs[i][1]]; c=p[pairs[i][2]];
    if(a.x===b.x) return {kind:'v', base:[a,b], apex:c, width:Math.abs(b.y-a.y),
                          height:Math.abs(c.x-a.x), baseMidY:(a.y+b.y)/2, centered:(a.y+b.y)/2===c.y};
  }
  return null;
}

/* ---------------- canvas ---------------- */
var cv=document.getElementById('cv'), ctx=cv.getContext('2d');
function css(v){ return getComputedStyle(document.documentElement).getPropertyValue(v).trim(); }

function resize(){
  var r=cv.getBoundingClientRect(), dpr=Math.min(window.devicePixelRatio||1,2);
  cv.width=Math.round(r.width*dpr); cv.height=Math.round(r.height*dpr);
  ctx.setTransform(cv.width/C,0,0,cv.height/C,0,0);
  draw();
}

function drawTri(p, stroke, fill, w){
  ctx.beginPath();
  ctx.moveTo(p[0].x,p[0].y); ctx.lineTo(p[1].x,p[1].y); ctx.lineTo(p[2].x,p[2].y); ctx.closePath();
  if(fill){ ctx.fillStyle=fill; ctx.fill(); }
  if(stroke){ ctx.strokeStyle=stroke; ctx.lineWidth=w||2; ctx.lineJoin='round'; ctx.stroke(); }
}

function draw(){
  var inkGrid=css('--grid'), inkGrid2=css('--grid2'), shape=css('--shape'),
      shapeFill=css('--shape-fill'), ink3=css('--ink3'), gold=css('--gold');
  ctx.clearRect(0,0,C,C);
  ctx.fillStyle=css('--canvas-bg'); ctx.fillRect(0,0,C,C);

  if(grid){
    ctx.lineWidth=0.6; ctx.strokeStyle=inkGrid;
    for(var i=20;i<C;i+=20){
      if(i%100===0) continue;
      ctx.beginPath(); ctx.moveTo(i,0); ctx.lineTo(i,C); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(0,i); ctx.lineTo(C,i); ctx.stroke();
    }
    ctx.lineWidth=1.1; ctx.strokeStyle=inkGrid2;
    for(var j=100;j<C;j+=100){
      ctx.beginPath(); ctx.moveTo(j,0); ctx.lineTo(j,C); ctx.stroke();
      ctx.beginPath(); ctx.moveTo(0,j); ctx.lineTo(C,j); ctx.stroke();
    }
    ctx.fillStyle=ink3; ctx.font='500 11px "IBM Plex Mono",monospace';
    ctx.textAlign='left'; ctx.textBaseline='top';
    ctx.fillText('0,0',3,3);
    ctx.textAlign='center';
    for(var k=100;k<C;k+=100) ctx.fillText(String(k),k,3);
    ctx.textAlign='left'; ctx.textBaseline='middle';
    for(var m=100;m<C;m+=100) ctx.fillText(String(m),3,m);
  }

  // composed stack behind
  for(var s=0;s<stack.length;s++){
    var t=stack[s], pts=[{x:t.p[0],y:t.p[1]},{x:t.p[2],y:t.p[3]},{x:t.p[4],y:t.p[5]}];
    drawTri(pts, colorMode? 'rgba(0,0,0,.45)' : shape, colorMode? t.c : shapeFill, 1.5);
  }

  // current triangle
  drawTri(P, shape, stack.length? 'transparent' : shapeFill, 2.5);

  if(guides){
    var mids=[mid(P[0],P[1]),mid(P[1],P[2]),mid(P[2],P[0])], g=centroid(P);
    ctx.setLineDash([4,4]); ctx.lineWidth=1.2; ctx.strokeStyle=gold;
    for(var q=0;q<3;q++){
      ctx.beginPath(); ctx.moveTo(mids[q].x,mids[q].y); ctx.lineTo(P[(q+2)%3].x,P[(q+2)%3].y); ctx.stroke();
    }
    ctx.setLineDash([]);
    for(var q2=0;q2<3;q2++){
      ctx.beginPath(); ctx.arc(mids[q2].x,mids[q2].y,4,0,6.2832);
      ctx.fillStyle=gold; ctx.fill();
    }
    ctx.beginPath(); ctx.arc(g.x,g.y,6,0,6.2832);
    ctx.fillStyle=gold; ctx.fill();
    ctx.strokeStyle=css('--surface'); ctx.lineWidth=2; ctx.stroke();
  }

  // handles
  for(var h=0;h<3;h++){
    var col=css(PC[h]), on=(h===sel);
    ctx.beginPath(); ctx.arc(P[h].x,P[h].y,on?9:7,0,6.2832);
    ctx.fillStyle=col; ctx.fill();
    ctx.strokeStyle=css('--canvas-bg'); ctx.lineWidth=2.5; ctx.stroke();
  }
  if(labels){
    var placed=[];
    for(var n=0;n<3;n++){
      var c2=css(PC[n]), tx=P[n].x, ty=P[n].y,
          txt=PN[n]+' ('+R(P[n].x)+', '+R(P[n].y)+')';
      ctx.font='600 12px "IBM Plex Mono",monospace';
      var w=ctx.measureText(txt).width+10, H=21, box=null,
          // right-above, right-below, left-above, left-below, then nudged further out
          cands=[[tx+13,ty-11],[tx+13,ty+3],[tx-13-w,ty-11],[tx-13-w,ty+3],
                 [tx+13,ty-30],[tx-13-w,ty-30],[tx+13,ty+22],[tx-13-w,ty+22]];
      for(var ci=0;ci<cands.length;ci++){
        var bx=Math.max(2,Math.min(C-2-w,cands[ci][0])),
            by=Math.max(2,Math.min(C-2-H,cands[ci][1])), hit=false;
        for(var pi=0;pi<placed.length;pi++){
          var q=placed[pi];
          if(bx < q.x+q.w+3 && bx+w+3 > q.x && by < q.y+q.h+3 && by+H+3 > q.y){ hit=true; break; }
        }
        if(!hit){ box={x:bx,y:by,w:w,h:H}; break; }
        if(ci===cands.length-1) box={x:bx,y:by,w:w,h:H};
      }
      placed.push(box);
      ctx.fillStyle=css('--surface'); ctx.strokeStyle=c2; ctx.lineWidth=1.2;
      if(ctx.roundRect){ ctx.beginPath(); ctx.roundRect(box.x,box.y,w,H,5); ctx.fill(); ctx.stroke(); }
      else { ctx.fillRect(box.x,box.y,w,H); ctx.strokeRect(box.x,box.y,w,H); }
      ctx.fillStyle=css('--ink'); ctx.textAlign='left'; ctx.textBaseline='middle';
      ctx.fillText(txt,box.x+5,box.y+H/2);
    }
  }
}

/* ---------------- pointer + keyboard ---------------- */
function toLogical(ev){
  var r=cv.getBoundingClientRect();
  return { x: clamp((ev.clientX-r.left)/r.width*C), y: clamp((ev.clientY-r.top)/r.height*C) };
}
function put(i,pt){
  var x=pt.x, y=pt.y;
  if(snap){ x=Math.round(x/20)*20; y=Math.round(y/20)*20; }
  P[i]={x:clamp(Math.round(x)), y:clamp(Math.round(y))};
  activeRecipe=null; refresh();
}
var dragging=-1;
cv.addEventListener('pointerdown',function(ev){
  var pt=toLogical(ev), best=-1, bd=1e9;
  for(var i=0;i<3;i++){ var d=Math.hypot(P[i].x-pt.x,P[i].y-pt.y); if(d<bd){bd=d;best=i;} }
  if(bd<=16){ dragging=best; sel=best; }
  else { dragging=sel; }
  cv.setPointerCapture(ev.pointerId); put(dragging,pt); ev.preventDefault();
});
cv.addEventListener('pointermove',function(ev){ if(dragging>=0) put(dragging,toLogical(ev)); });
cv.addEventListener('pointerup',function(ev){ dragging=-1; try{cv.releasePointerCapture(ev.pointerId);}catch(e){} save(); });
cv.addEventListener('pointercancel',function(){ dragging=-1; });

cv.addEventListener('keydown',function(ev){
  var k=ev.key, step=ev.shiftKey?1:(snap?20:10), moved=false;
  if(k==='1'||k==='2'||k==='3'){ sel=+k-1; draw(); announce(PN[sel]+' selected'); ev.preventDefault(); return; }
  var p={x:P[sel].x,y:P[sel].y};
  if(k==='ArrowLeft'){ p.x-=step; moved=true; }
  else if(k==='ArrowRight'){ p.x+=step; moved=true; }
  else if(k==='ArrowUp'){ p.y-=step; moved=true; }
  else if(k==='ArrowDown'){ p.y+=step; moved=true; }
  if(moved){
    P[sel]={x:clamp(p.x),y:clamp(p.y)}; activeRecipe=null; refresh(); save();
    announce(PN[sel]+' at '+R(P[sel].x)+', '+R(P[sel].y)); ev.preventDefault();
  }
});
function announce(t){ document.getElementById('live').textContent=t; }

/* ---------------- recipes ---------------- */
function T(a,b,c,d,e,f){ return [{x:a,y:b},{x:c,y:d},{x:e,y:f}]; }
var RECIPES=[
 {n:'Tent (isosceles)',      m:'apex x = (100 + 300) / 2 = 200',      p:T(100,300, 300,300, 200,140)},
 {n:'Equilateral, side 200', m:'height = 0.87 x 200 = 173 -> 320-173', p:T(100,320, 300,320, 200,147)},
 {n:'Right, corner top-left',m:'(100,100) (300,100) (100,280)',        p:T(100,100, 300,100, 100,280)},
 {n:'Right, corner bottom-left', m:'(100,300) (100,100) (320,300)',    p:T(100,300, 100,100, 320,300)},
 {n:'Points up',             m:'base below, apex above',               p:T(100,300, 300,300, 200,150)},
 {n:'Points down',           m:'base above, apex below',               p:T(100,100, 300,100, 200,250)},
 {n:'Points left',           m:'base is vertical on the right',        p:T(300,100, 300,300, 150,200)},
 {n:'Points right',          m:'base is vertical on the left',         p:T(100,100, 100,300, 250,200)},
 {n:'Centered, width 240',   m:'left = 200-120 = 80, right = 200+120 = 320', p:T(80,300, 320,300, 200,140)},
 {n:'Thin spike',            m:'narrow base, tall height',             p:T(180,340, 220,340, 200,60)},
 {n:'Half canvas wedge',     m:'corner to corner to corner',           p:T(0,0, 400,0, 0,400)},
 {n:'Lopsided (scalene)',    m:'no two sides the same',                p:T(60,320, 340,280, 240,80)}
];
function recipeSVG(p){
  var pts=p.map(function(q){ return (q.x/400*46+3).toFixed(1)+','+(q.y/400*38+3).toFixed(1); }).join(' ');
  return '<svg viewBox="0 0 52 44" aria-hidden="true"><rect x="1" y="1" width="50" height="42" rx="3" '+
    'fill="none" stroke="var(--line2)" stroke-width="1"/><polygon points="'+pts+
    '" fill="var(--shape-fill)" stroke="var(--shape)" stroke-width="1.6" stroke-linejoin="round"/></svg>';
}
function buildRecipes(){
  var host=document.getElementById('recipeList'), html='';
  RECIPES.forEach(function(r,i){
    html+='<button class="recipe" type="button" data-r="'+i+'" aria-pressed="false">'+recipeSVG(r.p)+
      '<span><span class="rname">'+r.n+'</span><span class="rmath">'+r.m+'</span></span></button>';
  });
  host.innerHTML=html;
  host.addEventListener('click',function(ev){
    var b=ev.target.closest('[data-r]'); if(!b) return;
    var r=RECIPES[+b.getAttribute('data-r')];
    P=r.p.map(function(q){return {x:q.x,y:q.y};});
    activeRecipe=+b.getAttribute('data-r');
    refresh(); save(); announce(r.n+' loaded');
  });
}

/* ---------------- patterns for the art piece ---------------- */
function eq(cx, baseY, w){ var h=Math.round(0.866*w); return [cx-w/2,baseY, cx+w/2,baseY, cx,baseY-h]; }
var PATTERNS={
 'Mountain strip': function(){
    var out=[], n=4, b=100, BY=300, TY=150, i;
    for(i=0;i<n;i++)   out.push({n:'Peak '+(i+1),  p:[b*i,BY, b*(i+1),BY, b*i+b/2,TY]});
    for(i=0;i<n-1;i++) out.push({n:'Valley '+(i+1),p:[b*i+b/2,TY, b*(i+1)+b/2,TY, b*(i+1),BY]});
    return out;
 },
 'Pinwheel fan': function(){
    var ring=[[350,200],[306,306],[200,350],[94,306],[50,200],[94,94],[200,50],[306,94]], out=[], i;
    for(i=0;i<8;i++) out.push({n:'Wedge '+(i+1), p:[200,200, ring[i][0],ring[i][1], ring[(i+1)%8][0],ring[(i+1)%8][1]]});
    return out;
 },
 'Nested equilaterals': function(){
    return [300,240,180,120,60].map(function(w,i){ return {n:'Ring '+(i+1), p:eq(200,320,w)}; });
 },
 'Mirror pair': function(){
    var a=[120,320, 220,320, 140,180];
    var b=[400-a[0],a[1], 400-a[2],a[3], 400-a[4],a[5]];
    return [{n:'Original',p:a},{n:'Mirrored (400 - x)',p:b}];
 },
 'Midpoint nest': function(){
    var A=[200,80], B=[80,320], Cc=[320,320];
    function md(p,q){ return [(p[0]+q[0])/2,(p[1]+q[1])/2]; }
    var AB=md(A,B), BC=md(B,Cc), CA=md(Cc,A);
    var ab2=md(A,AB), b2=md(AB,CA);
    return [
      {n:'Outer',           p:[A[0],A[1], B[0],B[1], Cc[0],Cc[1]]},
      {n:'Midpoints',       p:[AB[0],AB[1], BC[0],BC[1], CA[0],CA[1]]},
      {n:'Midpoints again', p:[ab2[0],ab2[1], b2[0],b2[1], A[0],A[1]]}
    ];
 }
};
function buildPatterns(){
  var host=document.getElementById('patternRow'), html='';
  Object.keys(PATTERNS).forEach(function(k){
    html+='<button class="btn ghost" type="button" data-pat="'+k+'">'+k+'</button>';
  });
  host.innerHTML=html;
  host.addEventListener('click',function(ev){
    var b=ev.target.closest('[data-pat]'); if(!b) return;
    var key=b.getAttribute('data-pat');
    stack = PATTERNS[key]().map(function(t,i){
      return {n:t.n, p:t.p.map(function(v){return Math.round(v);}), c:PALETTE[i%PALETTE.length]};
    });
    refresh(); save(); announce(key+' loaded, '+stack.length+' triangles');
  });
}

/* ---------------- code generation ---------------- */
function esc(s){ return s.replace(/&/g,'&amp;').replace(/</g,'&lt;'); }
function hl(src){
  return esc(src)
    .replace(/(\/\/[^\n]*)/g,'<span class="k-com">$1</span>')
    .replace(/\b(size|background|fill|noFill|stroke|noStroke|strokeWeight|triangle)\b/g,'<span class="k-fn">$1</span>')
    .replace(/\b(\d+)\b/g,'<span class="k-num">$1</span>');
}
function hex2rgb(h){
  return [parseInt(h.slice(1,3),16),parseInt(h.slice(3,5),16),parseInt(h.slice(5,7),16)];
}
function genCode(){
  var L=[], i;
  if(mode==='compose' && stack.length){
    L.push('/*');
    L.push(' * Triangle Art Piece');
    L.push(' * '+stack.length+' triangles, drawn back to front');
    L.push(' */');
    L.push('size(400, 400);');
    L.push('background(255);');
    L.push('');
    for(i=0;i<stack.length;i++){
      var t=stack[i];
      L.push('// '+(i+1)+'. '+t.n);
      if(colorMode){ var c=hex2rgb(t.c); L.push('fill('+c[0]+', '+c[1]+', '+c[2]+');'); }
      L.push('triangle('+t.p.join(', ')+');');
      L.push('');
    }
    while(L.length && L[L.length-1]==='') L.pop();
  } else {
    L.push('size(400, 400);');
    L.push('background(255);');
    L.push('');
    var a=anatomy(P);
    if(a && a.kind==='h'){
      L.push('// base from x = '+R(Math.min(a.base[0].x,a.base[1].x))+' to x = '+R(Math.max(a.base[0].x,a.base[1].x))+
             ', apex at x = '+R(a.apex.x));
    } else if(activeRecipe!==null){
      L.push('// '+RECIPES[activeRecipe].n);
    }
    L.push('triangle('+R(P[0].x)+', '+R(P[0].y)+', '+R(P[1].x)+', '+R(P[1].y)+', '+R(P[2].x)+', '+R(P[2].y)+');');
  }
  return L.join('\n');
}

/* ---------------- rail rendering ---------------- */
function renderPoints(){
  var h='';
  for(var i=0;i<3;i++){
    h+='<div class="ptrow"><span class="dot" style="background:var('+PC[i]+')"></span>'+
       '<span class="lbl">'+PN[i]+'</span>'+
       '<span class="val">'+R(P[i].x)+', '+R(P[i].y)+'</span>'+
       '<button type="button" data-pick="'+i+'" aria-label="Select '+PN[i]+'">'+(i===sel?'◉':'○')+'</button></div>';
  }
  document.getElementById('ptrows').innerHTML=h;
}
function row(k,v){ return '<dt>'+k+'</dt><dd>'+v+'</dd>'; }
function renderMath(){
  var a=anatomy(P), g=centroid(P), m=[mid(P[0],P[1]),mid(P[1],P[2]),mid(P[2],P[0])], h='';
  if(a && a.kind==='h'){
    h+=row('Base width','('+R(Math.max(a.base[0].x,a.base[1].x))+' − '+R(Math.min(a.base[0].x,a.base[1].x))+') = '+R(a.width));
    h+=row('Middle of base','('+R(a.base[0].x)+' + '+R(a.base[1].x)+') ÷ 2 = '+R(a.baseMidX));
    h+=row('Apex x',R(a.apex.x)+(a.centered?' ✓ centered':' — off by '+R(Math.abs(a.apex.x-a.baseMidX))));
    h+=row('Height','|'+R(a.apex.y)+' − '+R(a.base[0].y)+'| = '+R(a.height));
  } else if(a && a.kind==='v'){
    h+=row('Base height','|'+R(a.base[0].y)+' − '+R(a.base[1].y)+'| = '+R(a.width));
    h+=row('Middle of base','('+R(a.base[0].y)+' + '+R(a.base[1].y)+') ÷ 2 = '+R(a.baseMidY));
    h+=row('Apex y',R(a.apex.y)+(a.centered?' ✓ centered':' — off by '+R(Math.abs(a.apex.y-a.baseMidY))));
    h+=row('Width','|'+R(a.apex.x)+' − '+R(a.base[0].x)+'| = '+R(a.height));
  } else {
    h+=row('Base','no flat side — tilted triangle');
  }
  h+=row('Balance point','('+R(g.x)+', '+R(g.y)+')');
  h+=row('Midpoint P1–P2','('+R(m[0].x)+', '+R(m[0].y)+')');
  h+=row('Midpoint P2–P3','('+R(m[1].x)+', '+R(m[1].y)+')');
  h+=row('Midpoint P3–P1','('+R(m[2].x)+', '+R(m[2].y)+')');
  document.getElementById('mathList').innerHTML=h;

  var note='', kind=classify(P);
  if(a && a.kind==='h'){
    var ideal=Math.round(0.866*a.width);
    if(kind==='Equilateral'){
      note='<b>Equilateral.</b> All three sides match because the height '+R(a.height)+
           ' is about 0.87 × '+R(a.width)+' = '+ideal+'.';
    } else if(a.centered){
      note='<b>Apex is centered.</b> To make this equilateral, set the height to 0.87 × '+
           R(a.width)+' = <span class="mono">'+ideal+'</span>, so the apex y would be <span class="mono">'+
           R(a.base[0].y-ideal)+'</span>.';
    } else {
      note='<b>The apex is not over the middle of the base.</b> Move it to x = <span class="mono">'+
           R(a.baseMidX)+'</span> and the two slanted sides become equal.';
    }
  } else {
    note='<b>No flat side.</b> Give two points the same y (or the same x) and the lab can talk about a base, an apex and a height.';
  }
  document.getElementById('mathNote').innerHTML=note;
  document.getElementById('kindBadge').textContent=kind;
}
function renderStack(){
  var box=document.getElementById('stackBox'), h='';
