    box.innerHTML='<div class="empty">No triangles yet. Shape one on the canvas and press <b>Add this triangle</b>, or load a pattern below.</div>';
  } else {
    for(var i=0;i<stack.length;i++){
      var t=stack[i];
      h+='<div class="sitem"><span class="sw" style="background:'+(colorMode?t.c:'transparent')+'"></span>'+
         '<span class="snm">'+(i+1)+'. '+t.n+'</span>'+
         '<span class="sco">'+t.p.join(',')+'</span>'+
