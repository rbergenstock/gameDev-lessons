<div class="wrap">

  <header>
    <div class="brand">
      <div class="roundel">MH</div>
      <div>
        <div class="eyebrow">Intro to Computer Science &middot; Phase 2</div>
        <h1>Triangle Lab</h1>
        <p class="sub">Drag the three points. The lab does the arithmetic and writes the Processing code.</p>
      </div>
    </div>
    <div class="btnrow">
      <button class="chip" id="themeBtn" type="button">Dark mode</button>
    </div>
